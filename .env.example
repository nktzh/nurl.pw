# Скопируйте в .env и заполните: cp .env.example .env

# Адрес сайта для Caddy: ":80" для локального запуска (http://localhost),
# домен (например, "nurl.pw") на сервере: HTTPS-сертификат выпустится автоматически.
SITE_ADDRESS=:80

# PostgreSQL. Пароль без символов @ : / ? # (он подставляется в URL подключения).
POSTGRES_USER=nurl
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nurl
# Порт Postgres на хосте (слушает только 127.0.0.1)
POSTGRES_PORT=5433

# Строка подключения для запуска backend без Docker
# (в docker-compose собирается из POSTGRES_* автоматически).
DATABASE_URL=postgresql+asyncpg://nurl:change_me@localhost:5433/nurl

# Подпись токенов доступа: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me

# Общий лимит диска под файлы в ГБ (0 = без лимита)
STORAGE_QUOTA_GB=0
MAX_FILES_PER_DROP=500

# Origin'ы фронтенда для CORS (через запятую), нужны только при локальной разработке
CORS_ORIGINS=http://localhost:3000
